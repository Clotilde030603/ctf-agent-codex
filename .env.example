# Run storage and safety
CTF_RUNS_DIR=runs
CTF_REQUEST_TIMEOUT_SECONDS=20
CTF_TOOL_TIMEOUT_SECONDS=30
CTF_RETRY_BUDGET=2
CTF_SUBMISSION_BUDGET=1
CTF_MAX_HYPOTHESES=3
CTF_MAX_STATE_STEPS=100
CTF_MAX_EXTRACTION_DEPTH=3
CTF_MAX_EXTRACTED_BYTES=268435456
CTF_RATE_LIMIT_PER_SECOND=2
CTF_ALLOW_PRIVATE_HOSTS=false
CTF_ALLOW_LOCAL_REPRODUCTION=false
CTF_REDACT_FLAG=false
CTF_DOCKER_IMAGE=python:3.12-slim

# Optional explicit Playwright storage-state path.
# Default: runs/.sessions/<challenge-host>.json
# CTF_BROWSER_STORAGE_STATE=/secure/path/ctfd-storage-state.json

# Model backend configuration. The default codex path uses these settings for
# planner and controlled worker calls; availability depends on the local Codex CLI.
CTF_BACKEND=codex
CTF_CODEX_BINARY=codex
CTF_PLANNER_MODEL=gpt-5.6-sol
CTF_SOLVER_MODEL=gpt-5.6-sol
CTF_VERIFIER_MODEL=gpt-5.6-sol
CTF_PLANNER_EFFORT=high
CTF_SOLVER_EFFORT=xhigh
CTF_VERIFIER_EFFORT=high
CTF_MODEL_TIMEOUT_SECONDS=180
CTF_MODEL_CALL_BUDGET=20
CTF_MAX_MODEL_CONTEXT_BYTES=524288
CTF_MAX_WORKERS=3
CTF_ALLOW_STATIC_FALLBACK=false
CTF_TOTAL_RUN_TIMEOUT_SECONDS=3600
CTF_WORKER_MAX_STEPS=12
CTF_WORKER_MAX_COMMANDS=8
CTF_WORKER_MAX_HTTP_REQUESTS=8
CTF_WORKER_WALL_TIME_SECONDS=600
CTF_WORKER_NO_PROGRESS_LIMIT=3
